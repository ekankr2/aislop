{
  "name": "aislop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3300",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply aislop --remote",
    "db:migrate:local": "wrangler d1 migrations apply aislop --local",
    "db:seed:local": "wrangler d1 execute aislop --local --file ./seed.local.sql"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pretendard": "1.3.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "5.20260908.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.1",
    "drizzle-kit": "0.31.10",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
